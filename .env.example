# SUPABASE CONFIGURATION (Client-Safe: URL & Anon Key Only)
# Dapatkan dari Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# APP_URL: Host URL aplikasi
APP_URL="http://localhost:3000"

# DEMO MODE (Aktifkan tombol Demo Super Admin untuk evaluasi rapat / simulasi lokal)
VITE_DEMO_MODE="true"

